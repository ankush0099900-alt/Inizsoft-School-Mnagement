generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  slug                  String                 @unique
  email                 String?                @unique
  phone                 String?
  website               String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  postalCode            String?
  logo                  String?
  favicon               String?
  primaryColor          String?
  secondaryColor        String?
  principal             String?
  vicePrincipal         String?
  slogan                String?
  missionStatement      String?
  visionStatement       String?
  board                 String?
  academicYear          String?
  language              String?
  timezone              String?                @default("Asia/Kolkata")
  currency              String?                @default("INR")
  startHour             String?
  closeHour             String?
  isActive              Boolean                @default(true)
  isVerified            Boolean                @default(false)
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ownerId               String?                @unique
  status                SchoolStatus           @default(TRIAL)
  owner                 User?                  @relation("SchoolOwner", fields: [ownerId], references: [id])
  announcements         Announcement[]
  attendance            Attendance[]
  auditLogs             AuditLog[]
  classes               Class[]
  events                Event[]
  exams                 Exam[]
  fees                  Fee[]
  files                 File[]
  notifications         Notification[]
  notificationAudiences NotificationAudience[]
  parents               Parent[]
  results               Result[]
  roles                 Role[]
  modules               SchoolModule[]
  sections              Section[]
  settings              Setting[]
  subjects              Subject[]
  subscriptions         Subscription[]
  teachers              Teacher[]
  timetables            Timetable[]
  users                 User[]
  students                  Student[]
  admissionSequence         Int                        @default(0)
  subscriptionTransactions  SubscriptionTransaction[]
  paymentConfig             SchoolPaymentConfig?
  teacherSubjectAllocations TeacherSubjectAllocation[]

  @@index([ownerId])
  @@index([code])
  @@index([slug])
  @@index([isActive])
  @@index([status])
  @@map("schools")
}

model User {
  id                    String                 @id @default(uuid())
  schoolId              String?
  fullName              String
  email                 String                 @unique
  password              String
  phone                 String?
  avatar                String?
  status                UserStatus             @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  role                  RoleEnum
  deletedAt             DateTime?
  isDeleted             Boolean                @default(false)
  lastLoginAt           DateTime?
  failedLogins          Int                    @default(0)
  lockedUntil           DateTime?
  auditLogs             AuditLog[]
  files                 File[]
  createdNotifications  Notification[]         @relation("NotificationCreator")
  notificationAudiences NotificationAudience[] @relation("NotificationAudienceUser")
  parent                Parent?
  refreshTokens         RefreshToken[]
  student               Student?
  teacher               Teacher?
  school                School?                @relation(fields: [schoolId], references: [id])
  ownerOfSchool         School?                @relation("SchoolOwner")
  userRoles             UserRole[]
  notificationReads     NotificationRead[]
  reviewedTransactions  SubscriptionTransaction[] @relation("TransactionReviewer")
  paymentSettingsUpdated PlatformPaymentSetting[] @relation("PaymentSettingsUpdater")

  @@index([schoolId])
  @@index([status])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  schoolId   String?
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schoolId])
  @@index([expiresAt])
}

model ERPModule {
  id            String         @id @default(uuid())
  name          String
  key           String         @unique
  description   String?
  icon          String?
  route         String?
  category      String?
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  planModules   PlanModule[]
  schoolModules SchoolModule[]

  @@index([category])
  @@index([isActive])
}

model SchoolModule {
  id         String    @id @default(uuid())
  schoolId   String
  moduleId   String
  enabled    Boolean   @default(true)
  assignedBy String?
  assignedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  module     ERPModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, moduleId])
}

model SubscriptionPlan {
  id             String         @id @default(uuid())
  name           String         @unique
  code           String         @unique
  description    String?
  price          Decimal        @db.Decimal(12, 2)
  currency       String         @default("INR")
  durationInDays Int
  maxStudents    Int
  maxTeachers    Int
  maxAdmins      Int
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  modules                  PlanModule[]
  subscriptions            Subscription[]
  subscriptionTransactions SubscriptionTransaction[]
}

model PlanModule {
  id        String           @id @default(uuid())
  planId    String
  moduleId  String
  createdAt DateTime         @default(now())
  module    ERPModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model Subscription {
  id           String                    @id @default(uuid())
  schoolId     String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  planId       String
  status       SubscriptionStatus
  amount       Decimal                   @default(0) @db.Decimal(12, 2)
  discount     Decimal                   @default(0) @db.Decimal(12, 2)
  finalAmount  Decimal                   @default(0) @db.Decimal(12, 2)
  tax          Decimal                   @default(0) @db.Decimal(12, 2)
  plan         SubscriptionPlan          @relation(fields: [planId], references: [id])
  school       School                    @relation(fields: [schoolId], references: [id])
  transactions SubscriptionTransaction[]

  @@index([schoolId])
  @@index([status])
  @@index([endDate])
}

model Role {
  id          String           @id @default(uuid())
  schoolId    String?
  name        String
  key         String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, key])
  @@index([key])
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  key         String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Class {
  id                    String                 @id @default(uuid())
  schoolId              String
  name                  String
  classTeacherId        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendance            Attendance[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classTeacher          Teacher?               @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  notificationAudiences NotificationAudience[]
  sections                  Section[]
  timetables                Timetable[]
  enrollments               Enrollment[]
  teacherSubjectAllocations TeacherSubjectAllocation[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([classTeacherId])
}

model Teacher {
  id                        String                     @id @default(uuid())
  schoolId                  String
  userId                    String                     @unique
  employeeId                String
  qualification             String?
  experienceYears           Int?
  designation               String?
  address                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  joiningDate               DateTime?
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes                   Class[]                    @relation("ClassTeacher")
  timetables                Timetable[]
  subjects                  Subject[]                  @relation("TeacherSubjects")
  teacherSubjectAllocations TeacherSubjectAllocation[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model Section {
  id                        String                     @id @default(uuid())
  schoolId                  String
  classId                   String
  name                      String
  capacity                  Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  notificationAudiences     NotificationAudience[]
  class                     Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetables                Timetable[]
  enrollments               Enrollment[]
  teacherSubjectAllocations TeacherSubjectAllocation[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
}

model Student {
  id            String    @id @default(uuid())
  schoolId      String
  userId        String    @unique
  admissionNo   String
  rollNo        String?
  dob           DateTime?
  gender        Gender?
  address       String?
  parentId      String?
  guardianId    String?
  admissionDate DateTime?
  bloodGroup    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean   @default(false)

  attendance            Attendance[]
  fees                  Fee[]
  notificationAudiences NotificationAudience[]
  results               Result[]
  enrollments           Enrollment[]
  homeworkSubmissions   HomeworkSubmission[]

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent Parent? @relation(fields: [parentId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([schoolId, admissionNo])
  @@index([schoolId, deletedAt])
}



model Parent {
  id           String    @id @default(uuid())
  schoolId     String
  userId       String    @unique
  occupation   String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  annualIncome Decimal?  @db.Decimal(12, 2)
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     Student[]

  @@index([schoolId])
}

model Subject {
  id          String      @id @default(uuid())
  schoolId    String
  name        String
  code        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  description String?
  results     Result[]
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetables                Timetable[]
  teachers                  Teacher[]                  @relation("TeacherSubjects")
  teacherSubjectAllocations TeacherSubjectAllocation[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Attendance {
  id             String           @id @default(uuid())
  schoolId       String
  academicYearId String?
  studentId      String
  classId        String
  attendanceDate DateTime
  status         AttendanceStatus
  markedById     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  remarks        String?
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceDate])
  @@index([schoolId])
  @@index([schoolId, academicYearId, attendanceDate])
  @@index([studentId])
  @@index([attendanceDate])
}

model Exam {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String?
  name           String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  description    String?
  examType       String?
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results        Result[]

  @@index([schoolId])
  @@index([schoolId, academicYearId, startDate])
}

model Result {
  id             String   @id @default(uuid())
  examId         String
  studentId      String
  subjectId      String
  marks          Decimal  @db.Decimal(12, 2)
  grade          String?
  createdAt      DateTime @default(now())
  remarks        String?
  schoolId       String?
  academicYearId String?
  totalMarks     Decimal  @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  school         School?  @relation(fields: [schoolId], references: [id])
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@index([examId])
  @@index([studentId])
  @@index([schoolId])
  @@index([schoolId, academicYearId, studentId])
}

model Timetable {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String?
  subjectId      String
  teacherId      String
  day            String
  startTime      String
  endTime        String
  period         Int
  roomNo         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@index([schoolId, academicYearId, classId])
  @@index([schoolId, academicYearId, sectionId])
  @@index([schoolId, academicYearId, teacherId, day])
  @@index([schoolId, academicYearId, day, period])
}

model Fee {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String?
  studentId      String
  amount         Decimal   @db.Decimal(12, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(12, 2)
  dueDate        DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  paidDate       DateTime?
  paymentMethod  String?
  remarks        String?
  title          String
  transactionId  String?
  status         FeeStatus @default(PENDING)
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
}

model AcademicYear {
  id          String       @id @default(uuid())
  schoolId    String
  name        String
  code        String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean      @default(false)
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  timetables  Timetable[]

  @@unique([schoolId, code])
  @@index([schoolId, isCurrent])
  @@index([schoolId, startDate, endDate])
  @@index([schoolId, deletedAt])
}

model Enrollment {
  id             String           @id @default(uuid())
  schoolId       String
  academicYearId String
  studentId      String
  classId        String
  sectionId      String?
  rollNo         String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  withdrawnAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean          @default(false)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, studentId])
  @@index([schoolId, academicYearId, classId])
  @@index([schoolId, academicYearId, sectionId])
  @@index([schoolId, studentId])
  @@index([schoolId, deletedAt])
}

model Staff {
  id          String      @id @default(uuid())
  schoolId    String
  userId      String?     @unique
  employeeId  String
  fullName    String
  designation String?
  department  String?
  phone       String?
  email       String?
  joiningDate DateTime?
  salary      Decimal?    @db.Decimal(12, 2)
  status      StaffStatus @default(ACTIVE)
  address     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean     @default(false)

  @@unique([schoolId, employeeId])
  @@index([schoolId, designation])
  @@index([schoolId, deletedAt])
}

model Guardian {
  id           String    @id @default(uuid())
  schoolId     String
  userId       String?   @unique
  fullName     String
  relationship String?
  phone        String?
  email        String?
  occupation   String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)

  @@index([schoolId, phone])
  @@index([schoolId, deletedAt])
}

model Admission {
  id             String          @id @default(uuid())
  schoolId       String
  academicYearId String
  applicationNo  String
  studentName    String
  appliedClassId String?
  guardianName   String?
  guardianPhone  String?
  status         AdmissionStatus @default(PENDING)
  submittedAt    DateTime        @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean         @default(false)

  @@unique([schoolId, applicationNo])
  @@index([schoolId, academicYearId, status])
  @@index([schoolId, deletedAt])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  schoolId        String
  academicYearId  String?
  applicantUserId String
  leaveType       String
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cancelledAt     DateTime?

  @@index([schoolId, applicantUserId, startDate])
  @@index([schoolId, status])
}

model Homework {
  id             String         @id @default(uuid())
  schoolId       String
  academicYearId String?
  classId        String
  sectionId      String?
  subjectId      String
  teacherId      String?
  title          String
  description    String?
  assignedAt     DateTime       @default(now())
  dueDate        DateTime
  attachmentId   String?
  status         HomeworkStatus @default(PUBLISHED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean        @default(false)

  submissions HomeworkSubmission[]

  @@index([schoolId, academicYearId, classId])
  @@index([schoolId, subjectId, dueDate])
  @@index([schoolId, deletedAt])
}

model HomeworkSubmission {
  id           String                   @id @default(uuid())
  schoolId     String
  homeworkId   String
  studentId    String
  submittedAt  DateTime                 @default(now())
  status       HomeworkSubmissionStatus @default(SUBMITTED)
  attachmentId String?
  content      String?
  marks        Float?
  remarks      String?
  gradedAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean                  @default(false)

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, homeworkId, studentId])
  @@index([schoolId, homeworkId])
  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, submittedAt])
  @@index([schoolId, deletedAt])
}

model Mark {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  examId         String
  studentId      String
  subjectId      String
  obtainedMarks  Decimal  @db.Decimal(12, 2)
  maxMarks       Decimal  @db.Decimal(12, 2)
  grade          String?
  remarks        String?
  enteredById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, examId, studentId, subjectId])
  @@index([schoolId, academicYearId, studentId])
  @@index([schoolId, examId, subjectId])
}

model Invoice {
  id             String        @id @default(uuid())
  schoolId       String
  academicYearId String?
  studentId      String
  invoiceNo      String
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([schoolId, invoiceNo])
  @@index([schoolId, academicYearId, studentId])
  @@index([schoolId, status, dueDate])
}

model Payment {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String?
  receiptNo      String
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  method         PaymentMethod
  referenceNo    String?
  status         PaymentStatus @default(CAPTURED)
  receivedById   String?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paymentDate])
  @@index([schoolId, studentId])
  @@index([schoolId, status])
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  schoolId  String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentId, invoiceId])
  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentId])
}

model Expense {
  id            String         @id @default(uuid())
  schoolId      String
  expenseNo     String
  category      String
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime
  vendor        String?
  paymentMethod PaymentMethod?
  status        ExpenseStatus  @default(RECORDED)
  description   String?
  createdById   String?
  reversedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([schoolId, expenseNo])
  @@index([schoolId, expenseDate])
  @@index([schoolId, category])
}

model Payroll {
  id            String        @id @default(uuid())
  schoolId      String
  employeeId    String
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Decimal       @db.Decimal(12, 2)
  deductions    Decimal       @default(0) @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  status        PayrollStatus @default(DRAFT)
  paidAt        DateTime?
  processedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([schoolId, employeeId, periodStart, periodEnd])
  @@index([schoolId, periodStart, periodEnd])
  @@index([schoolId, status])
}

model LibraryBook {
  id           String    @id @default(uuid())
  schoolId     String
  isbn         String?
  accessionNo  String
  title        String
  author       String?
  publisher    String?
  category     String?
  quantity     Int       @default(1)
  availableQty Int       @default(1)
  price        Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)

  @@unique([schoolId, accessionNo])
  @@index([schoolId, title])
  @@index([schoolId, deletedAt])
}

model LibraryIssue {
  id         String             @id @default(uuid())
  schoolId   String
  bookId     String
  borrowerId String
  issuedAt   DateTime           @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineAmount Decimal            @default(0)
  status     LibraryIssueStatus @default(ISSUED)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([schoolId, borrowerId, status])
  @@index([schoolId, bookId, status])
}

model TransportRoute {
  id          String    @id @default(uuid())
  schoolId    String
  name        String
  vehicleNo   String?
  driverName  String?
  driverPhone String?
  stops       Json?
  fee         Decimal?  @db.Decimal(12, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model TransportAssignment {
  id         String           @id @default(uuid())
  schoolId   String
  studentId  String
  routeId    String
  pickupStop String?
  dropStop   String?
  startDate  DateTime
  endDate    DateTime?
  fee        Decimal?         @db.Decimal(12, 2)
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([schoolId, studentId, status])
  @@index([schoolId, routeId])
}

model Hostel {
  id         String    @id @default(uuid())
  schoolId   String
  name       String
  address    String?
  wardenName String?
  capacity   Int?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  isDeleted  Boolean   @default(false)

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model HostelAllocation {
  id        String           @id @default(uuid())
  schoolId  String
  hostelId  String
  studentId String
  roomNo    String?
  bedNo     String?
  startDate DateTime
  endDate   DateTime?
  status    AssignmentStatus @default(ACTIVE)
  fee       Decimal?         @db.Decimal(12, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([schoolId, studentId, status])
  @@index([schoolId, hostelId, roomNo])
}

model InventoryItem {
  id           String          @id @default(uuid())
  schoolId     String
  sku          String
  name         String
  category     String?
  unit         String?
  quantity     Decimal         @db.Decimal(12, 2)
  reorderLevel Decimal         @default(0) @db.Decimal(12, 2)
  unitPrice    Decimal?        @db.Decimal(12, 2)
  status       InventoryStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean         @default(false)

  @@unique([schoolId, sku])
  @@index([schoolId, category])
  @@index([schoolId, status])
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  schoolId    String
  itemId      String
  type        InventoryTransactionType
  quantity    Decimal                  @db.Decimal(12, 2)
  unitPrice   Decimal?                 @db.Decimal(12, 2)
  referenceNo String?
  remarks     String?
  createdById String?
  createdAt   DateTime                 @default(now())

  @@index([schoolId, itemId, createdAt])
  @@index([schoolId, type])
}

model Communication {
  id             String               @id @default(uuid())
  schoolId       String
  channel        CommunicationChannel
  subject        String?
  message        String
  recipientCount Int                  @default(0)
  status         CommunicationStatus  @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean              @default(false)

  @@index([schoolId, channel, status])
  @@index([schoolId, scheduledAt])
}

model Document {
  id           String    @id @default(uuid())
  schoolId     String
  entityType   String
  entityId     String
  name         String
  fileId       String?
  version      Int       @default(1)
  metadata     Json?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)

  @@index([schoolId, entityType, entityId])
  @@index([schoolId, deletedAt])
}

model Notification {
  id          String                 @id @default(uuid())
  title       String
  message     String
  type        NotificationType
  priority    NotificationPriority   @default(NORMAL)
  status      NotificationStatus     @default(DRAFT)
  createdById String?
  schoolId    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  expiresAt   DateTime?
  isPinned    Boolean                @default(false)
  isDeleted   Boolean                @default(false)
  deletedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   User?                  @relation("NotificationCreator", fields: [createdById], references: [id])
  school      School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  audiences   NotificationAudience[]
  reads       NotificationRead[]

  @@index([schoolId])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@index([schoolId, status])
  @@index([schoolId, createdAt])
}

model NotificationAudience {
  id             String                 @id @default(uuid())
  notificationId String
  targetType     NotificationTargetType
  schoolId       String?
  role           RoleEnum?
  classId        String?
  sectionId      String?
  userId         String?
  studentId      String?
  createdAt      DateTime               @default(now())
  notification   Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  school         School?                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class          Class?                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section?               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user           User?                  @relation("NotificationAudienceUser", fields: [userId], references: [id], onDelete: Cascade)
  student        Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([notificationId, targetType, schoolId, role, classId, sectionId, userId, studentId])
  @@index([notificationId])
  @@index([targetType])
  @@index([schoolId])
  @@index([role])
  @@index([classId])
  @@index([sectionId])
  @@index([userId])
  @@index([studentId])
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
}

model Announcement {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  message     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime?
  publishedAt DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([expiresAt])
}

model Event {
  id          String    @id @default(uuid())
  schoolId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  location    String?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([startDate])
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  meta       Json?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())
  browser    String?
  device     String?
  ipAddress  String?
  module     String
  userAgent  String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
  @@index([module])
  @@index([ipAddress])
}

model Setting {
  id        String   @id @default(uuid())
  schoolId  String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([key])
  @@index([schoolId])
}

model File {
  id           String   @id @default(uuid())
  schoolId     String?
  uploadedById String?
  fileName     String
  originalName String
  mimeType     String
  extension    String
  size         Int
  path         String
  folder       String?
  disk         String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([uploadedById])
  @@index([folder])
}

