// ==========================================
// BILLING & TRANSACTION AUDIT LEDGER
// ==========================================

enum TransactionStatus {
  PENDING
  UNDER_REVIEW
  COMPLETED
  FAILED
  REJECTED
  REFUNDED
}

enum SubscriptionOperation {
  PURCHASE
  RENEW
  UPGRADE
}

enum PaymentChannel {
  ONLINE_RAZORPAY
  ONLINE_STRIPE
  MANUAL_BANK_TRANSFER
  MANUAL_UPI
  MANUAL_CHEQUE
  MANUAL_CASH
}

model SubscriptionTransaction {
  id                   String                @id @default(uuid())
  schoolId             String
  subscriptionId       String?
  planId               String
  operation            SubscriptionOperation @default(PURCHASE)
  amount               Decimal               @db.Decimal(12, 2)
  currency             String                @default("INR")
  status               TransactionStatus     @default(PENDING)
  channel              PaymentChannel
  paymentDate          DateTime              @default(now())

  // Online Gateway References
  gatewayOrderId       String?               @unique
  gatewayPaymentId     String?               @unique
  gatewaySignature     String?

  // Manual Payment References
  transactionReference String?
  proofDocumentUrl     String?
  reviewedById         String?
  reviewNotes          String?
  rejectionReason      String?
  reviewedAt           DateTime?

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan      @relation(fields: [planId], references: [id])
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  reviewedBy           User?                 @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
  @@index([channel])
  @@index([operation])
  @@index([transactionReference])
  @@index([createdAt])
}

model PlatformPaymentSetting {
  id                  String    @id @default(uuid())
  beneficiaryName     String
  upiId               String
  qrCodeUrl           String?
  bankName            String
  accountNumber       String
  ifscCode            String
  accountType         String?   @default("CURRENT")
  branchName          String?
  paymentInstructions String?
  isActive            Boolean   @default(true)
  updatedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  updatedBy           User?     @relation("PaymentSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_payment_settings")
}

// ==========================================
// TEACHER SUBJECT ALLOCATION
// ==========================================

model TeacherSubjectAllocation {
  id         String   @id @default(uuid())
  schoolId   String
  teacherId  String
  classId    String
  sectionId  String?
  subjectId  String
  createdAt  DateTime @default(now())

  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

// ==========================================
// SCHOOL PAYMENT GATEWAY CONFIGURATION
// ==========================================

model SchoolPaymentConfig {
  id             String   @id @default(uuid())
  schoolId       String   @unique
  provider       String   // "RAZORPAY" | "STRIPE"
  keyId          String
  keySecretEnc   String   // AES-256 encrypted secret
  webhookSecret  String?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

